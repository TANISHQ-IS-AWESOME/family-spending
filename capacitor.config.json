{
  "appId": "io.github.tanishqisawesome.tilly",
  "appName": "Tilly",
  "webDir": "www",
  "backgroundColor": "#121216",
  "ios": {
    "contentInset": "never",
    "includePlugins": [
      "@capacitor/app",
      "@capacitor/camera",
      "@capacitor/local-notifications",
      "@capacitor/network"
    ]
  },
  "android": {
    "allowMixedContent": false
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_tilly",
      "iconColor": "#E8B04B"
    },
    "SystemBars": {
      "style": "DARK"
    }
  }
}
